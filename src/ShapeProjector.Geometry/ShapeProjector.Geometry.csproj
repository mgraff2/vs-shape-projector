<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure geometry library for the Jonastech Shape Projector.
    Plain data in, plain data out. No package references, no Vintage Story assemblies.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ShapeProjector.Geometry</RootNamespace>
    <AssemblyName>ShapeProjector.Geometry</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
